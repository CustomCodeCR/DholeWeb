# Dhole Web always enters through the API Gateway.
# run-dhole.sh replaces DHOLE_HOST_IP automatically before startup.
VITE_APP_VERSION=
VITE_APP_NAME=DholeSystem
VITE_API_URL=http://192.168.1.12:5200
VITE_FRONTEND_DOMAIN=http://192.168.1.12:5173
VITE_STORAGE_GATEWAY_PATH=/api/storage

SERVER_NAME=
SSL_CERTIFICATE=
SSL_CERTIFICATE_KEY=

VITE_AUTH_URL=http://192.168.1.12:5201
VITE_CONFIG_URL=http://192.168.1.12:5202
VITE_AUDITLOGS_URL=http://192.168.1.12:5203
VITE_PRICING_URL=http://192.168.1.12:5204
VITE_DATA_EXTRACTION_URL=http://192.168.1.12:5205
VITE_AI_URL=http://192.168.1.12:5206

VITE_REPORTS_URL=http://192.168.1.12:5208

VITE_NOTIFICATIONS_URL=http://192.168.1.12:5209
