{
  "name": "dholeweb",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/check-pricing-origin-sale.mjs && run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "test:seo": "node --test tests/seoPreview.test.ts",
    "test:redirects": "node --test tests/redirectFlow.test.ts",
    "test:media": "node --test tests/mediaLibrary.test.ts",
    "test:marketing": "node --test tests/marketingModule.test.ts tests/marketingRedesign.test.ts tests/marketingVisualEditor.test.ts tests/marketingBlockPresets.test.ts tests/marketingMediaPicker.test.ts tests/marketingMediaLibrary.test.ts",
    "test:marketing-ai": "node --test tests/marketingAi.test.ts",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.38",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.2",
    "prettier": "3.8.4",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.0",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
